# DGX Spark / GB10 (Grace-Blackwell, sm_121, aarch64).
# GB10 needs CUDA >= 12.8, so upstream's torch 2.5.1/cu124 stack can't target it.
# CUDA 13 + torch 2.10 + cp312 is the only combo with an official prebuilt
# aarch64 flash-attn wheel, so nothing in this image compiles.
FROM nvidia/cuda:13.0.2-cudnn-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV USE_HF=1
ENV VLLM_USE_MODELSCOPE=true

# Base image ships no python. Noble's python3 is 3.12, matching the cp312 wheels.
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-dev \
    python3-venv \
    git \
    libsndfile1 \
    ffmpeg \
    sox \
    wget \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# venv because Ubuntu 24.04 marks the system interpreter externally-managed (PEP 668)
ENV VIRTUAL_ENV=/opt/venv
RUN python3 -m venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

WORKDIR /workspace

# --index-url, not --extra-index-url: PyPI's aarch64 torch is a CPU-only build
# and pip would rank it above the CUDA one.
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cu130 \
    torch==2.10.0 torchaudio==2.10.0 torchvision==0.25.0

# Strip upstream's torch pins so pip doesn't drag the cu124 stack back in.
COPY requirements.txt .
RUN sed -i -E '/^(torch|torchaudio|torchvision)==/d' requirements.txt \
    && pip install --no-cache-dir -r requirements.txt
RUN pip install --no-cache-dir qwen-tts==0.1.1 qwen-asr==0.0.6 --no-deps

# Official prebuilt wheel: exact match for cu13 + torch2.10 + cp312 + aarch64.
# Its sm_120 cubins are binary-compatible with GB10's sm_121.
# Don't rebuild this targeting 12.1 -- that is what breaks the kernels.
RUN pip install --no-cache-dir \
    https://github.com/Dao-AILab/flash-attention/releases/download/v2.8.3/flash_attn-2.8.3%2Bcu13torch2.10cxx11abiTRUE-cp312-cp312-linux_aarch64.whl

COPY src/ /workspace/src/
# Copy build info if exists (generated by push_image.sh)
COPY build_info.jso[n] /workspace/

EXPOSE 7860 6006

ENV PYTHONPATH="/workspace/src"

CMD ["python", "src/webui.py"]
